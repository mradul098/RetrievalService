# Environment: "local" or "production"
ENVIRONMENT=local

# --- Local (Ollama) embedding settings ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Production (Vertex AI / Gemini) embedding settings ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-004

# --- Production (Elasticsearch) settings ---
ELASTICSEARCH_URL=https://your-es-cluster:9200
ELASTICSEARCH_API_KEY=your-api-key
ELASTICSEARCH_INDEX_PREFIX=rag-chunks

# --- Local store paths ---
LOCAL_FAISS_INDEX_PATH=data/faiss.index
LOCAL_SQLITE_DB_PATH=data/chunks.db

# --- Retrieval settings ---
TOP_K_MAX=50
TOP_K_DEFAULT=8
RANK_CONSTANT=20
EMBEDDING_DIMS=768

# --- Server ---
HOST=0.0.0.0
PORT=8002
